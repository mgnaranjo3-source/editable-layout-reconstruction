    { "id": "book-right", "type": "shape", "shape": "rounded-rectangle", "corner_radius": 6, "z": 6, "group": "illustration",
      "bbox": { "x": 410, "y": 370, "w": 90, "h": 140 }, "fill": "#E07A5F" },

    { "id": "date-time", "type": "text", "z": 7, "group": "details",
      "bbox": { "x": 122, "y": 650, "w": 556, "h": 38 },
      "text": "Saturday, March 14 · 10 AM – 1 PM", "font_family": "Arial", "font_category": "sans-serif", "font_size": 34,
      "font_weight": 700, "color": "#1F4E5F", "align": "center", "role": "body-emphasis" },

    { "id": "location", "type": "text", "z": 8, "group": "details",
      "bbox": { "x": 238, "y": 707, "w": 325, "h": 29 },
      "text": "Community Library, Room B", "font_family": "Arial", "font_category": "sans-serif", "font_size": 26,
      "font_weight": 400, "color": "#3D3D3D", "align": "center", "role": "body" },

    { "id": "tagline", "type": "text", "z": 9, "group": "details",
      "bbox": { "x": 144, "y": 750, "w": 511, "h": 25 },
      "text": "Bring a book, take a book · Trae un libro, llévate otro", "font_family": "Arial", "font_category": "sans-serif",
      "font_size": 22, "font_weight": 400, "color": "#3D3D3D", "align": "center", "role": "body", "language": "en+es" },

    { "id": "cta-button", "type": "shape", "shape": "rounded-rectangle", "corner_radius": 35, "z": 10, "group": "cta",
      "bbox": { "x": 250, "y": 820, "w": 300, "h": 70 }, "fill": "#E07A5F" },

    { "id": "cta-label", "type": "text", "z": 11, "group": "cta",
      "bbox": { "x": 332, "y": 840, "w": 136, "h": 31 },
      "text": "Free entry", "font_family": "Arial", "font_category": "sans-serif", "font_size": 28,
      "font_weight": 700, "color": "#FFFFFF", "align": "center", "role": "button-label" },

    { "id": "footer-note", "type": "text", "z": 12, "group": "footer",
      "bbox": { "x": 249, "y": 944, "w": 303, "h": 20 },
      "text": "Sample design for demonstration only", "font_family": "Arial", "font_category": "sans-serif", "font_size": 18,
      "font_weight": 400, "color": "#7A7A7A", "align": "center", "role": "caption" }
