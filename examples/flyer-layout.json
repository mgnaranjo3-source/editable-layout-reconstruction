  "groups": [
    { "id": "header", "members": ["header-band", "title", "subtitle"] },
    { "id": "illustration", "members": ["illustration-circle", "book-left", "book-right"] },
    { "id": "details", "members": ["date-time", "location", "tagline"] },
    { "id": "cta", "members": ["cta-button", "cta-label"] },
    { "id": "footer", "members": ["footer-note"] }
  ],
  "palette": ["#FFF8EE", "#1F4E5F", "#F6C667", "#E07A5F", "#3D3D3D", "#7A7A7A", "#FFFFFF"]
}
