{
  "canvas": { "width": 800, "height": 1000, "units": "px", "origin": "top-left", "background": "#FFF8EE" },
  "source": "examples/flyer-flat.png",
  "elements": [
    { "id": "header-band", "type": "shape", "shape": "rectangle", "z": 1, "group": "header",
      "bbox": { "x": 0, "y": 0, "w": 800, "h": 220 }, "fill": "#1F4E5F" },

    { "id": "title", "type": "text", "z": 2, "group": "header",
      "bbox": { "x": 218, "y": 62, "w": 364, "h": 73 },
      "text": "Book Swap", "font_family": "Georgia", "font_category": "serif", "font_size": 64,
      "font_weight": 700, "color": "#FFFFFF", "align": "center", "role": "headline" },

    { "id": "subtitle", "type": "text", "z": 3, "group": "header",
      "bbox": { "x": 256, "y": 148, "w": 288, "h": 34 },
      "text": "Intercambio de Libros", "font_family": "Arial", "font_category": "sans-serif", "font_size": 30,
      "font_weight": 400, "color": "#F6C667", "align": "center", "role": "subheadline", "language": "es" },

    { "id": "illustration-circle", "type": "shape", "shape": "ellipse", "z": 4, "group": "illustration",
      "bbox": { "x": 250, "y": 290, "w": 300, "h": 300 }, "fill": "#F6C667" },

    { "id": "book-left", "type": "shape", "shape": "rounded-rectangle", "corner_radius": 6, "z": 5, "group": "illustration",
